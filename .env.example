DHAN_CLIENT_ID=1000000001
DHAN_ACCESS_TOKEN=            # paste 24h token here, OR use TOTP flow below
DHAN_PIN=                     # 6-digit login PIN (for TOTP auth)
DHAN_TOTP_SECRET=             # base32 secret from web.dhan.co TOTP setup
DHAN_LIVE=0                   # set to 1 to send real orders
MAX_QTY=50
MAX_ORDER_VALUE=50000
MAX_DAILY_LOSS=10000
STRATEGY_INTERVAL=60
LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR, CRITICAL
JOURNAL_PATH=trades.csv       # path for the trade journal CSV
FEED_MODE=poll                # poll or ws (WebSocket)
